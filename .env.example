# Copy to `.env` and adjust.  NEVER commit `.env`.

# Base URL of the CTFd instance (without /api/v1).
CTFD_BASE_URL=https://demo.ctfd.io

# Optional credentials (loaded into memory only, never persisted).
# Prefer an access token over username/password.
CTFD_ADMIN_TOKEN=
CTFD_SESSION_COOKIE=
CTFD_USERNAME=
CTFD_PASSWORD=

# HTTP client behaviour.
CTFD_HTTP_TIMEOUT=15

# Where downloaded challenge files are stored.
FILE_CACHE_DIR=./file_cache

# MCP transport: stdio (default) or sse (HTTP).
CTFD_MCP_TRANSPORT=stdio

# REST server bind settings (server/main.py only).
MCP_HOST=0.0.0.0
MCP_PORT=8000

# Strongly discouraged: persist secrets to server_state.json.
CTFD_PERSIST_SECRETS=false